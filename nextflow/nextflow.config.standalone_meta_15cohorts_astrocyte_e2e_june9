/*
 * Astrocyte-only 15-cohort meta from the end-to-end June 9 replay tree.
 * Same lift map as June 9. Reads validation/e2e_june9/<cohort>/regenie_step2.
 */
includeConfig 'nextflow.config.standalone_meta_15cohorts'

params {
    pre_harmonized_input_dir = null
    cell_type_include        = ['Astrocyte']
    run_plot_meta            = false
    run_cohort_audit         = false
    run_heterogeneity_summary = false
    run_heterogeneity_breakdown = false

    meta_input_results_dir   = "${results_root}/validation/e2e_june9"

    output_dir               = "${results_root}/validation/e2e_june9_meta"
    harmonized_output_dir    = "${results_root}/validation/e2e_june9_meta/harmonized"
    audit_output_dir         = "${results_root}/validation/e2e_june9_meta/audit"
    heterogeneity_output_dir = "${results_root}/validation/e2e_june9_meta/heterogeneity"

    cohort_genome_builds = [
        "GTEx_v10":    "hg38",
        "AMP_AD_Rush": "hg38",
        "AMP_AD_Mayo": "hg38"
    ]
}
