/*
 * 15-cohort meta-analysis LDSC follow-up:
 *   - Reuses harmonized sumstats + METAL results from the 15-cohort meta run
 *     via -resume (run in run_dirs/meta_15cohorts with work/meta_15cohorts)
 *   - Enables LDSC post-meta h2 for all 19 cell types
 *   - run_plot_meta = false (plots are generated separately)
 *
 * Mirrors nextflow.config.standalone_meta_13cohorts_ldsc.
 *
 * Run:
 *   sbatch run_meta_15cohorts_ldsc.sbatch
 */

includeConfig 'nextflow.config.standalone_meta_15cohorts'

params {
    run_ldsc = true
    run_plot_meta = false

    // LDSC references: originally /nethome/kcni/xzhou/GWAS_tut/LDSC_Euro_ref, then
    // stlab ref_data on CAMH, now the SCC tree copied to Trillium.  Same contents as
    // used for the 13-cohort h2 run.  ldsc_ref_root comes from nextflow.config.trillium.
    ldsc_conda_env             = "ldsc"

    // ldsc.py / munge_sumstats.py are a git checkout, not conda entry points, so the
    // imported `ldsc` env supplies only python 2.7 + deps (numpy 1.16 / scipy 0.18 /
    // pandas 0.20 / bitarray 0.8.3) and not the scripts.  run_ldsc_h2.nf prepends
    // this to PATH so its `command -v ldsc.py` check passes.
    ldsc_bin_dir               = "${refs_root}/tools/ldsc"
    ldsc_variant_map           = "${ldsc_ref_root}/ROSMAP_WGS_joint_SNPs_rsID/id_snp_matcher.txt"
    ldsc_max_missing_variant_map_frac = 0.2
    ldsc_merge_alleles         = "${ldsc_ref_root}/eur_w_ld_chr/w_hm3.snplist"
    ldsc_hm3_snplist           = "${ldsc_ref_root}/eur_w_ld_chr/w_hm3.snplist"
    ldsc_ref_ld_chr            = "${ldsc_ref_root}/eur_w_ld_chr"
    ldsc_w_ld_chr              = "${ldsc_ref_root}/eur_w_ld_chr"
    ldsc_sumstats_outdir       = "${output_dir}/ldsc/sumstats"
    ldsc_results_outdir        = "${output_dir}/ldsc/results"
    ldsc_summary_outdir        = "${output_dir}/ldsc/summary"
}

process {
    withName: 'PREPARE_LDSC_SUMSTATS' {
        cpus = 2
        memory = { 32.GB * task.attempt }
        time = { 2.h * task.attempt }
        maxRetries = 5
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxForks = 3
    }
    withName: 'RUN_LDSC_H2' {
        time = '8h'
        maxForks = 14
    }
}
