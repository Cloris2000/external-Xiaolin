/*
 * 15-cohort × all 19 cell types meta from the nobio-deconv GWAS tree.
 * Same June 9 lift map (hg38 only for GTEx_v10, AMP_AD_Rush, AMP_AD_Mayo).
 */
includeConfig 'nextflow.config.standalone_meta_15cohorts'

params {
    pre_harmonized_input_dir  = null
    cell_type_include         = []
    run_plot_meta             = false
    run_cohort_audit          = false
    run_heterogeneity_summary = false
    run_heterogeneity_breakdown = false

    meta_input_results_dir   = "${results_root}/validation/gwas_nobio_allct"

    output_dir               = "${results_root}/validation/gwas_nobio_allct_meta"
    harmonized_output_dir    = "${results_root}/validation/gwas_nobio_allct_meta/harmonized"
    audit_output_dir         = "${results_root}/validation/gwas_nobio_allct_meta/audit"
    heterogeneity_output_dir = "${results_root}/validation/gwas_nobio_allct_meta/heterogeneity"

    cohort_genome_builds = [
        "GTEx_v10":    "hg38",
        "AMP_AD_Rush": "hg38",
        "AMP_AD_Mayo": "hg38"
    ]
}
