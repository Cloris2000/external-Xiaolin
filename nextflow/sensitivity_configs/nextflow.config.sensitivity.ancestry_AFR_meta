/*
 * Ancestry-specific meta: AFR / African American samples only.
 *
 * Cohorts (all re_gwas subsets):
 *   NIMH_HBCC_1M_AFR, NIMH_HBCC_h650_AFR, AMP_AD_Rush_AFR, AMP_AD_Mayo_AFR
 *
 * Run: sbatch run_ancestry_meta_AFR.sbatch
 */
includeConfig '../nextflow.config.standalone_meta_15cohorts'

params {
    stratified_meta_label = "ancestry_AFR"
    stratified_meta_dimension = "ancestry_specific"

    cohorts = [
        "NIMH_HBCC_1M_AFR",
        "NIMH_HBCC_h650_AFR",
        "AMP_AD_Rush_AFR",
        "AMP_AD_Mayo_AFR"
    ]
    cohort_include = [
        "NIMH_HBCC_1M_AFR",
        "NIMH_HBCC_h650_AFR",
        "AMP_AD_Rush_AFR",
        "AMP_AD_Mayo_AFR"
    ]

    output_dir = "${projectDir}/results/meta_sensitivity/ancestry_specific_AFR"
    harmonized_output_dir = "${params.output_dir}/harmonized"
    audit_output_dir = "${params.output_dir}/audit"
    heterogeneity_output_dir = "${params.output_dir}/heterogeneity"

    cohort_genome_builds = [
        "AMP_AD_Rush_AFR": "hg38",
        "AMP_AD_Mayo_AFR": "hg38"
    ]
    liftover_chain_hg38_to_hg19 = "${projectDir}/reference_data/hg38ToHg19.over.chain.gz"

    run_heterogeneity_summary = true
    run_plot_meta = false
    run_heterogeneity_breakdown = false
}
