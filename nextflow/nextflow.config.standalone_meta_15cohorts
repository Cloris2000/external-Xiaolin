/*
 * 15-cohort meta-analysis:
 *   Original 8: ROSMAP, Mayo, MSBB, CMC_MSSM, CMC_PENN, CMC_PITT, GTEx_v10, NABEC
 *   HBCC 3 platforms: NIMH_HBCC_1M, NIMH_HBCC_h650, NIMH_HBCC_Omni5M
 *   GVEX
 *   ROSMAP_array (170 TOPmed imputed array samples not in WGS pipeline)
 *   AMP-AD Diverse: AMP_AD_Rush, AMP_AD_Mayo
 *
 * Changes vs 13-cohort meta:
 *   - GTEx upgraded from v8 → v10 (GRCh38 WGS, larger N)
 *   - Added AMP_AD_Rush  (~133 DLPFC samples, GRCh38 WGS)
 *   - Added AMP_AD_Mayo  (~234 DLPFC samples, GRCh38 WGS)
 *
 * Requires all 15 cohorts to have completed GWAS (raw_p files present):
 *   results/{cohort}/regenie_step2/{cohort}_*_step2.regenie.raw_p
 *
 * Run:
 *   sbatch run_meta_15cohorts.sbatch
 */

includeConfig 'nextflow.config.standalone_meta'

// Override HARMONIZE_META_SUMSTATS for 15-cohort run:
// With 15 cohorts the harmonization script handles ~15x the data vs the 8-cohort run,
// so 2h base time is insufficient. Exit code 140 = SLURM wall-time kill (SIGXCPU),
// which needs the same retry+time-scaling treatment as exit 137 (OOM kill).
process {
    withName: 'HARMONIZE_META_SUMSTATS' {
        cpus          = 1
        memory        = { 32.GB * task.attempt }
        time          = { 4.h  * task.attempt }  // 4h → 8h → 12h on retries
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }


}

params {
    // Stage 0 (META_COHORT_AUDIT) globs {base_dir}/results/{cohort}/regenie_step2/
    // and does not honour meta_input_results_dir.  A from-raw re-run writes new
    // raw_p files under this repo's results/, so point here (not the old SCC tree).
    base_dir = "${projectDir}"
    cohort_metadata_file = "${projectDir}/docs/meta_cohort_metadata.tsv"

    // Re-harmonize from the new per-cohort GWAS.  The CAMH pre-harmonized
    // directory is still at /project/rrg-shreejoy/zhoux156/harmonized_15cohorts
    // if you ever want to skip this again.
    pre_harmonized_input_dir = null

    // Track A only needs the .tbl files for comparison and downstream analyses.
    run_plot_meta = false

    cohorts = [
        "ROSMAP", "ROSMAP_array",
        "Mayo", "MSBB",
        "CMC_MSSM", "CMC_PENN", "CMC_PITT",
        "GTEx_v10", "NABEC",
        "NIMH_HBCC_1M", "NIMH_HBCC_h650", "NIMH_HBCC_Omni5M",
        "GVEX",
        "AMP_AD_Rush", "AMP_AD_Mayo"
    ]

    cohort_include = [
        "ROSMAP", "ROSMAP_array",
        "Mayo", "MSBB",
        "CMC_MSSM", "CMC_PENN", "CMC_PITT",
        "GTEx_v10", "NABEC",
        "NIMH_HBCC_1M", "NIMH_HBCC_h650", "NIMH_HBCC_Omni5M",
        "GVEX",
        "AMP_AD_Rush", "AMP_AD_Mayo"
    ]

    // Compute nodes mount projectDir read-only, so output must go to scratch and
    // be synced to ${nf_root}/results afterwards (scripts/sync_results_to_project.sh).
    // results_root comes from nextflow.config.trillium.
    output_dir = "${results_root}/meta_analysis_15cohorts"

    // These are derived from output_dir in nextflow.config.standalone_meta, but that
    // interpolation resolves against the base default (results/meta_analysis) before
    // the override above is applied — so they have to be restated here, otherwise
    // 15-cohort audit/heterogeneity output lands in the 8-cohort results tree.
    harmonized_output_dir    = "${results_root}/meta_analysis_15cohorts/harmonized"
    audit_output_dir         = "${results_root}/meta_analysis_15cohorts/audit"
    heterogeneity_output_dir = "${results_root}/meta_analysis_15cohorts/heterogeneity"

    // GTEx_v10 uses GTEx v9 WGS (GRCh38); AMP-AD Diverse WGS is also GRCh38.
    // All other cohorts in this meta are hg19/b37.
    // Only consulted when harmonizing from raw REGENIE output; inert while
    // pre_harmonized_input_dir is set, since those files are already lifted.
    // liftover_chain_hg38_to_hg19 comes from nextflow.config.trillium.
    cohort_genome_builds = [
        "GTEx_v10":    "hg38",
        "AMP_AD_Rush": "hg38",
        "AMP_AD_Mayo": "hg38"
    ]
}
