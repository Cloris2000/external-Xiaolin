/*
 * ROSMAP Mathys snRNA-seq (Hodge label-transfer) cell-proportion GWAS
 *
 * Proper "Mathys" single-nucleus cohort built from the SEA-AD/BRISC label
 * transfer table (data/Mathys/mathys_hodge_subclass_fine_hodge19_labels.csv),
 * replacing the earlier PsychAD_RADC_snRNA stand-in which only matched 89
 * genotyped donors.
 *
 * Inputs:
 *   data_input/sn_rosmap_mathys_hodge_wgs/{cell_proportions,metadata}.csv
 *     - proportions: 16 Hodge subclasses, individualID = R*
 *       (built from Hodge_subclass_fine_hodge19, passed_QC cells only;
 *        L5.ET absent, Pericyte/VLMC dropped as <5 cells total)
 *     - metadata: Sex, Age_at_Death, PMI from ROSMAP_clinical.csv
 *   368 donors have proportions; 323 overlap the ROSMAP full-WGS genotype QC.
 *
 * Genotype (precomputed, full-cohort ROSMAP joint WGS, b37):
 *   results/ROSMAP/ROSMAP.QC.final  (796 samples, SM-* IIDs)
 *   ID map: R* -> SM-* via ROSMAP biospecimen (assay=wholeGenomeSeq).
 *   -> 323 Mathys donors intersect the genotype (vs 89 for RADC).
 *
 * Genome build: b37 (ROSMAP WGS). No liftover needed for meta with the
 * other hg19 sn / bulk CTP cohorts.
 *
 * Run:
 *   nextflow run combined_pipeline_v2.nf \
 *       -c nextflow.config.combined.sn_rosmap_mathys_hodge_wgs \
 *       -w work/sn_rosmap_mathys_hodge_wgs
 */

includeConfig 'nextflow.config.combined'

params {
    cohorts          = ["ROSMAP_Mathys_Hodge"]
    study            = "ROSMAP_Mathys_Hodge"
    genotyping_study = "ROSMAP"
    conda_env        = "test"

    precomputed_proportions = "${projectDir}/data_input/sn_rosmap_mathys_hodge_wgs/cell_proportions.csv"
    precomputed_metadata    = "${projectDir}/data_input/sn_rosmap_mathys_hodge_wgs/metadata.csv"
    precomputed_pgen        = "${projectDir}/results/ROSMAP/ROSMAP.QC.final"

    // 16 cell types present with adequate representation in the Mathys labels.
    // (L5.ET has 0 cells; Pericyte/VLMC dropped as essentially absent.)
    cell_type_list = [
        "Astrocyte", "Endothelial", "IT", "L4.IT", "L5.6.IT.Car3", "L5.6.NP",
        "L6.CT", "L6b", "LAMP5", "Microglia", "OPC", "Oligodendrocyte",
        "PAX6", "PVALB", "SST", "VIP"
    ]
    skip_metal = true

    biospecimen_file       = '/project/rrg-shreejoy/ROSMAP/Metadata/ROSMAP_biospecimen_metadata.csv'
    fid_method             = 'biospec_specimen'
    fid_format             = ''
    biospec_assay_filter   = 'wholeGenomeSeq'
    biospec_col_individual = 'individualID'
    biospec_col_specimen   = 'specimenID'

    col_msex         = 'Sex'
    col_age          = 'Age_at_Death'
    col_individualID = 'individualID'

    plink_path    = "/project/rrg-shreejoy/pipeline_refs/tools/plink2"
    bcftools_path = "/home/zhoux156/miniforge3/envs/bcftools_env/bin/bcftools"

    regenie_path    = "/project/rrg-shreejoy/pipeline_refs/tools/regenie"
    metal_path      = "/project/rrg-shreejoy/pipeline_refs/tools/metal"
    regenie_threads = 12
    regenie_bsize   = 1000

    cohort_configs = [
        "ROSMAP_Mathys_Hodge": [
            pgen_file:     "${projectDir}/results/ROSMAP/ROSMAP.QC.final",
            prune_in_file: "${projectDir}/results/sn_rosmap_mathys_hodge_wgs/ROSMAP.QC.prune.in",
            pheno_file:    "${projectDir}/results/sn_rosmap_mathys_hodge_wgs/phenotypes_RINT.txt",
            covar_file:    "${projectDir}/results/sn_rosmap_mathys_hodge_wgs/covariates.txt"
        ]
    ]

    work_dir   = "${projectDir}/work/sn_rosmap_mathys_hodge_wgs"
    log_dir    = "${projectDir}/logs/sn_rosmap_mathys_hodge_wgs"
    output_dir = "${projectDir}/results/sn_rosmap_mathys_hodge_wgs"
    use_slurm  = true
    slurm_time = "0-4:0"
}

process {
    // medium partition nodes have broken SLURM prologs; use mediumtmp
    clusterOptions = '--partition=mediumtmp'
    errorStrategy = 'retry'
    maxRetries = 3

    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:REGENIE_STEP1' {
        cpus = 12; memory = '48 GB'
    }
    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:REGENIE_STEP2' {
        cpus = 12; memory = '48 GB'
    }
    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:EXTRACT_PHENOTYPE_COLUMN' {
        cpus = 1; memory = '4 GB'
    }
}

report   { enabled = true;  file = "${params.output_dir}/combined_pipeline_report.html" }
timeline { enabled = true;  file = "${params.output_dir}/combined_pipeline_timeline.html" }
trace    { enabled = false }
dag      { enabled = true;  file = "${params.output_dir}/combined_pipeline_dag.svg" }
