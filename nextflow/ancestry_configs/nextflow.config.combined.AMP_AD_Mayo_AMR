/*
 * Ancestry-subset GWAS: AMP_AD_Mayo_AMR (N=178)
 *
 * Parent config: nextflow.config.combined.amp_ad_mayo
 * Keep list: docs/ancestry_specific/keep_lists/AMP_AD_Mayo_AMR_samples_to_keep.txt
 * QC/VCF basename: AMP_AD_Mayo_AMR
 *
 * Strategy:
 *   - Reuse parent cell proportions / metadata (skip RNA + deconv)
 *   - Restrict samples via samples_to_keep
 *   - Re-run genotyping QC + REGENIE on the ancestry subset
 *
 * Run:
 *   mkdir -p run_dirs/AMP_AD_Mayo_AMR work/AMP_AD_Mayo_AMR logs/AMP_AD_Mayo_AMR
 *   nextflow run combined_pipeline_v2.nf \
 *       -c ancestry_configs/nextflow.config.combined.AMP_AD_Mayo_AMR \
 *       -work-dir work/AMP_AD_Mayo_AMR \
 *       -resume
 */

includeConfig '../nextflow.config.combined.amp_ad_mayo'

params {
    cohorts = ["AMP_AD_Mayo_AMR"]
    study   = "AMP_AD_Mayo_AMR"
    genotyping_study = null

    samples_to_keep = "${projectDir}/docs/ancestry_specific/keep_lists/AMP_AD_Mayo_AMR_samples_to_keep.txt"

    precomputed_proportions = "${projectDir}/results/AMP_AD_Mayo/cell_proportions.csv"
    precomputed_metadata    = "${projectDir}/results/AMP_AD_Mayo/combined_metrics.csv"

    // Bump so cached CREATE_PGEN from failed pilots is not reused
    qc_version = "v4_ancestry"

    wgs_psam_file = "${projectDir}/results/AMP_AD_Mayo_AMR/AMP_AD_Mayo_AMR.QC.final.psam"
    pca_file      = "${projectDir}/results/AMP_AD_Mayo_AMR/pca.csv"

    work_dir   = "${projectDir}/work/AMP_AD_Mayo_AMR"
    log_dir    = "${projectDir}/logs/AMP_AD_Mayo_AMR"
    output_dir = "${projectDir}/results/AMP_AD_Mayo_AMR"

    skip_metal = true

    cohort_configs = [
        "AMP_AD_Mayo_AMR": [
            pgen_file:     "${projectDir}/results/AMP_AD_Mayo_AMR/AMP_AD_Mayo_AMR.QC.final",
            prune_in_file: "${projectDir}/results/AMP_AD_Mayo_AMR/AMP_AD_Mayo_AMR.QC.prune.in",
            pheno_file:    "${projectDir}/results/AMP_AD_Mayo_AMR/phenotypes_RINT.txt",
            covar_file:    "${projectDir}/results/AMP_AD_Mayo_AMR/covariates.txt"
        ]
    ]
}
