/*
 * ROSMAP Green snRNA-seq (Hodge label-transfer) cell-proportion GWAS
 *
 * Inputs:
 *   data_input/sn_rosmap_green_hodge/{cell_proportions,metadata}.csv
 *     - proportions: 19 Hodge subclasses, individualID = R*
 *     - metadata: Sex, Age_at_Death collapsed from Green_metadata_extract.csv
 *
 * Genotype (precomputed, sn-filtered):
 *   results/sn_ROSMAP/ROSMAP.QC.final  (SM-* IIDs)
 * ID map: R* -> SM-* via ROSMAP biospecimen (assay=wholeGenomeSeq)
 *
 *   nextflow run combined_pipeline_v2.nf -c nextflow.config.combined.sn_rosmap_green_hodge \
 *       -w work/sn_rosmap_green_hodge
 */

includeConfig 'nextflow.config.combined'

params {
    cohorts          = ["ROSMAP_Green_Hodge"]
    study            = "ROSMAP_Green_Hodge"
    genotyping_study = "ROSMAP"
    conda_env        = "test"

    precomputed_proportions = "${projectDir}/data_input/sn_rosmap_green_hodge/cell_proportions.csv"
    precomputed_metadata    = "${projectDir}/data_input/sn_rosmap_green_hodge/metadata.csv"
    precomputed_pgen        = "${projectDir}/results/sn_ROSMAP/ROSMAP.QC.final"

    cell_type_list = [
        "Astrocyte", "Endothelial", "IT", "L4.IT", "L5.ET", "L5.6.IT.Car3",
        "L5.6.NP", "L6.CT", "L6b", "LAMP5", "Microglia", "OPC",
        "Oligodendrocyte", "PAX6", "PVALB", "Pericyte", "SST", "VIP", "VLMC"
    ]
    skip_metal = true

    biospecimen_file       = '/project/rrg-shreejoy/ROSMAP/Metadata/ROSMAP_biospecimen_metadata.csv'
    fid_method             = 'biospec_specimen'
    fid_format             = ''
    biospec_assay_filter   = 'wholeGenomeSeq'
    biospec_col_individual = 'individualID'
    biospec_col_specimen   = 'specimenID'

    col_msex         = 'Sex'
    col_age          = 'Age_at_Death'
    col_individualID = 'individualID'

    plink_path    = "/project/rrg-shreejoy/pipeline_refs/tools/plink2"
    bcftools_path = "/home/zhoux156/miniforge3/envs/bcftools_env/bin/bcftools"

    regenie_path    = "/project/rrg-shreejoy/pipeline_refs/tools/regenie"
    metal_path      = "/project/rrg-shreejoy/pipeline_refs/tools/metal"
    regenie_threads = 12
    regenie_bsize   = 1000

    cohort_configs = [
        "ROSMAP_Green_Hodge": [
            pgen_file:     "${projectDir}/results/sn_ROSMAP/ROSMAP.QC.final",
            prune_in_file: "${projectDir}/results/sn_rosmap_green_hodge/ROSMAP.QC.prune.in",
            pheno_file:    "${projectDir}/results/sn_rosmap_green_hodge/phenotypes_RINT.txt",
            covar_file:    "${projectDir}/results/sn_rosmap_green_hodge/covariates.txt"
        ]
    ]

    work_dir   = "${projectDir}/work/sn_rosmap_green_hodge"
    log_dir    = "${projectDir}/logs/sn_rosmap_green_hodge"
    output_dir = "${projectDir}/results/sn_rosmap_green_hodge"
    use_slurm  = true
    slurm_time = "0-4:0"
}

process {
    // medium partition nodes have broken SLURM prologs; use mediumtmp
    clusterOptions = '--partition=mediumtmp'
    errorStrategy = 'retry'
    maxRetries = 3

    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:REGENIE_STEP1' {
        cpus = 12; memory = '48 GB'
    }
    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:REGENIE_STEP2' {
        cpus = 12; memory = '48 GB'
    }
    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:EXTRACT_PHENOTYPE_COLUMN' {
        cpus = 1; memory = '4 GB'
    }
}

report   { enabled = true;  file = "${params.output_dir}/combined_pipeline_report.html" }
timeline { enabled = true;  file = "${params.output_dir}/combined_pipeline_timeline.html" }
trace    { enabled = false }
dag      { enabled = true;  file = "${params.output_dir}/combined_pipeline_dag.svg" }
