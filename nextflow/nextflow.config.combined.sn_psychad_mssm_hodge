/*
 * PsychAD MSSM snRNA-seq (Hodge label-transfer) cell-proportion GWAS
 * Restricted to donors with MSBB WGS (~203 / 876).
 *
 * Inputs (IDs already remapped AMPAD_MSSM_* -> MSBB specimen numeric IID):
 *   data_input/sn_psychad_mssm_hodge/{cell_proportions,metadata}.csv
 * Clinical covariates from NPS-AD_individual_metadata.csv (sex, ageDeath).
 * Specimen map from NPS-AD_individuals_with_WGS_and_snpArray_metadata.csv.
 *
 * Genotype (precomputed):
 *   results/MSBB/MSBB.QC.final
 *
 *   nextflow run combined_pipeline_v2.nf -c nextflow.config.combined.sn_psychad_mssm_hodge \
 *       -w work/sn_psychad_mssm_hodge
 */

includeConfig 'nextflow.config.combined'

params {
    cohorts          = ["PsychAD_MSSM_Hodge"]
    study            = "PsychAD_MSSM_Hodge"
    genotyping_study = "MSBB"
    conda_env        = "test"

    precomputed_proportions = "${projectDir}/data_input/sn_psychad_mssm_hodge/cell_proportions.csv"
    precomputed_metadata    = "${projectDir}/data_input/sn_psychad_mssm_hodge/metadata.csv"
    precomputed_pgen        = "${projectDir}/results/MSBB/MSBB.QC.final"

    cell_type_list = [
        "Astrocyte", "Endothelial", "IT", "L4.IT", "L5.ET", "L5.6.IT.Car3",
        "L5.6.NP", "L6.CT", "L6b", "LAMP5", "Microglia", "OPC",
        "Oligodendrocyte", "PAX6", "PVALB", "Pericyte", "SST", "VIP", "VLMC"
    ]
    skip_metal = true

    // IDs are already MSBB specimen IIDs matching the WGS psam
    fid_method       = 'individual_id'
    fid_format       = ''
    biospecimen_file = ''

    col_msex         = 'sex'
    col_age          = 'ageDeath'
    col_individualID = 'individualID'

    plink_path    = "/external/rprshnas01/kcni/mwainberg/software/plink2"
    bcftools_path = "/nethome/kcni/xzhou/.anaconda3/envs/bcftools_env/bin/bcftools"

    regenie_path    = "/external/rprshnas01/kcni/mwainberg/software/regenie"
    metal_path      = "/external/rprshnas01/netdata_kcni/stlab/Xiaolin/WGS/METAL/generic-metal/executables"
    regenie_threads = 12
    regenie_bsize   = 1000

    cohort_configs = [
        "PsychAD_MSSM_Hodge": [
            pgen_file:     "${projectDir}/results/MSBB/MSBB.QC.final",
            prune_in_file: "${projectDir}/results/sn_psychad_mssm_hodge/MSBB.QC.prune.in",
            pheno_file:    "${projectDir}/results/sn_psychad_mssm_hodge/phenotypes_RINT.txt",
            covar_file:    "${projectDir}/results/sn_psychad_mssm_hodge/covariates.txt"
        ]
    ]

    work_dir   = "${projectDir}/work/sn_psychad_mssm_hodge"
    log_dir    = "${projectDir}/logs/sn_psychad_mssm_hodge"
    output_dir = "${projectDir}/results/sn_psychad_mssm_hodge"
    use_slurm  = true
    slurm_time = "0-4:0"
}

process {
    // medium partition nodes have broken SLURM prologs; use mediumtmp
    clusterOptions = '--partition=mediumtmp'
    errorStrategy = 'retry'
    maxRetries = 3

    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:REGENIE_STEP1' {
        cpus = 12; memory = '48 GB'
    }
    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:REGENIE_STEP2' {
        cpus = 12; memory = '48 GB'
    }
    withName: 'COMBINED_PIPELINE:GWAS_PIPELINE:EXTRACT_PHENOTYPE_COLUMN' {
        cpus = 1; memory = '4 GB'
    }
}

report   { enabled = true;  file = "${params.output_dir}/combined_pipeline_report.html" }
timeline { enabled = true;  file = "${params.output_dir}/combined_pipeline_timeline.html" }
trace    { enabled = false }
dag      { enabled = true;  file = "${params.output_dir}/combined_pipeline_dag.svg" }
